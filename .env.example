# GDGoC HNU OS — Environment Variables Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any secrets to source control.

# ==============================================================================
# Supabase Configuration (Phase 0 - Step 0.2)
# Obtain from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Base App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Google Drive Bridge (Phase 9)
# ==============================================================================
GOOGLE_DRIVE_SCRIPT_URL=
GOOGLE_DRIVE_SCRIPT_SECRET=

# ==============================================================================
# Notifications & Email (Phase 12)
# ==============================================================================
EMAIL_PROVIDER_API_KEY=

# ==============================================================================
# Anti-Abuse & Bot Protection (Phase 16)
# ==============================================================================
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ==============================================================================
# Vercel Cron Secret (Phase 10 / §10.4)
# ==============================================================================
CRON_SECRET=
